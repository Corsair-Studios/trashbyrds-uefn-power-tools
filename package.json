{
  "name": "trashbyrds-uefn-power-tools",
  "version": "0.1.4",
  "description": "MCP server + Python tools for live, chat-driven inspection and editing of a UEFN project, Verse, and assets.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "tsx uefn-server.ts",
    "build": "esbuild uefn-server.ts --bundle --platform=node --format=esm --target=node18 --outfile=uefn-server.mjs",
    "sync:project": "node scripts/sync-to-project.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "esbuild": "^0.21.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
